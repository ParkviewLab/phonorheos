<?xml version="1.0" encoding="utf-8"?>
<!--
SPDX-FileCopyrightText: 2026 Gary Frattarola <garyf@parkviewlab.ai>
SPDX-License-Identifier: AGPL-3.0-or-later

Puts the command's folder, bin\ in the install folder, on the system PATH, so that
`phonorheos say` works in a new terminal; uninstalling takes it off again. The command
is a console program of its own there, since the app's phonorheos.exe opens no console.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PhonorheosCommandOnPath" Guid="BC9F7DFE-33DC-4178-8482-36466F22E03E">
        <Environment Id="PhonorheosPathEntry" Name="PATH" Value="[INSTALLDIR]bin" Action="set" Part="last" System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\ParkviewLab\phonorheos" Name="CommandOnPath" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
