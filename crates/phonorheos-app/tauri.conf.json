{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "phonorheos",
  "mainBinaryName": "phonorheos",
  "version": "0.0.0",
  "identifier": "ai.parkviewlab.phonorheos",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "phonorheos", "width": 780, "height": 680, "minWidth": 560, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi"],
    "category": "Utility",
    "shortDescription": "Speaks the text other apps send it",
    "copyright": "© 2026 Gary Frattarola",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "15.0", "hardenedRuntime": true },
    "windows": { "wix": { "fragmentPaths": ["wix/path.wxs"], "componentRefs": ["PhonorheosCommandOnPath"] } }
  }
}
