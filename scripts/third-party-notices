#!/usr/bin/env -S python3 -I
# SPDX-FileCopyrightText: 2026 Gary Frattarola <garyf@parkviewlab.ai>
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Writes THIRD-PARTY-NOTICES.txt, which the app carries: every Rust crate built into
it and every Python package in its bundled Python, with its licence and the licence
and notice files it ships. Refuses, listing them, when any is under a strong copyleft
licence (GPL or AGPL), which the requirements exclude.

Usage: scripts/third-party-notices <rust target triple> <bundled python dir> <output>
"""

import email
import json
import pathlib
import re
import subprocess
import sys

STRONG = re.compile(r"\b(A?GPL|GNU General Public|Affero)", re.IGNORECASE)
NOTICE = re.compile(r"^(LICEN[CS]E|COPYING|NOTICE|COPYRIGHT|AUTHORS)", re.IGNORECASE)


def rust(target):
    meta = json.loads(
        subprocess.check_output(["cargo", "metadata", "--format-version", "1", "--filter-platform", target, "--locked"])
    )
    ours = set(meta["workspace_members"])
    used = {n["id"] for n in meta["resolve"]["nodes"]}
    for p in sorted(meta["packages"], key=lambda p: p["name"]):
        if p["id"] in ours or p["id"] not in used:
            continue
        root = pathlib.Path(p["manifest_path"]).parent
        files = sorted(f for f in root.iterdir() if f.is_file() and NOTICE.match(f.name))
        yield f"{p['name']} {p['version']} (Rust crate)", p.get("license") or "see its files", files


def python(site):
    for meta in sorted(pathlib.Path(site).glob("*.dist-info/METADATA")):
        msg = email.message_from_bytes(meta.read_bytes())
        if msg["Name"] == "phonorheos-helper":
            continue
        lic = (msg.get("License-Expression") or "").strip()
        if not lic:
            classifiers = [v.split("::")[-1].strip() for k, v in msg.items() if k == "Classifier" and v.startswith("License ::")]
            first = (msg.get("License") or "").strip().splitlines()
            lic = "; ".join(classifiers) or (first[0][:100] if first else "") or "see its files"
        info = meta.parent
        files = sorted(f for f in info.rglob("*") if f.is_file() and NOTICE.match(f.name))
        yield f"{msg['Name']} {msg['Version']} (Python package)", lic, files


def main(target, pydir, out):
    # python-build-standalone keeps them in lib/python3.12/site-packages, on Windows in
    # Lib/site-packages.
    sites = [*pathlib.Path(pydir).glob("lib/python3*/site-packages"), *pathlib.Path(pydir).glob("Lib/site-packages")]
    entries = list(rust(target)) + [e for s in sites for e in python(s)]
    strong = [(n, lic) for n, lic, _ in entries if STRONG.search(lic) and not re.search(r"\bL?GPL.*exception|LGPL|Lesser", lic, re.I)]
    if strong:
        for n, lic in strong:
            print(f"strong copyleft: {n}: {lic}", file=sys.stderr)
        sys.exit(1)
    with open(out, "w", encoding="utf-8") as f:
        f.write("phonorheos carries the software listed below, each under its own licence.\n")
        f.write("Kokoro's model and voices are not carried: the app downloads them on first run (Apache-2.0).\n\n")
        for name, lic, files in entries:
            f.write("=" * 78 + f"\n{name}\nLicence: {lic}\n")
            for file in files:
                text = file.read_text(encoding="utf-8", errors="replace").strip()
                f.write(f"\n--- {file.name} ---\n{text}\n")
            f.write("\n")
    print(f"{len(entries)} third-party components → {out}")


if __name__ == "__main__":
    if len(sys.argv) != 4:
        sys.exit(__doc__)
    main(*sys.argv[1:])
